#!/bin/sh
# Strip any Claude-Session trailer before a commit is written.
#
# Some assistant tooling appends a line naming the session that produced a
# commit. That is metadata about how the code was written, and this repository
# is public: publishing it is the maintainer's decision, not a tool's default.
# The hook makes the repository's preference win regardless of what any tool
# tries to add.
#
# Enable with:  git config core.hooksPath .githooks
grep -v '^Claude-Session:' "$1" > "$1.tmp" && mv "$1.tmp" "$1"
# Drop any blank line the removal left at the end of the message.
awk 'NF {p=1} p' "$1" | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' > "$1.tmp" && mv "$1.tmp" "$1"
